#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG_FILE="${NVERR_CONFIG:-/hive/bin/nvErr.cfg}"
readonly CURSOR_FILE="/dev/shm/nvErr.cursor"
readonly LOCK_FILE="/dev/shm/nvErr.lock"

TELEGRAM_ENABLED=0
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
    [[ -n "${TELEGRAM_TOKEN:-}" && -n "${CHAT_ID:-}" ]] && TELEGRAM_ENABLED=1
fi

format_errors() {
    local smi=""
    if command -v nvidia-smi >/dev/null 2>&1; then
        smi=$(timeout 10 nvidia-smi --query-gpu=pci.bus_id,index \
              --format=csv,noheader 2>/dev/null || true)
    fi

    awk -v smi="$smi" '
        function norm(b,   p) {
            b = tolower(b)
            if (match(b, /^[0-9a-f]+:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]/)) {
                split(substr(b, RSTART, RLENGTH), p, ":")
                return substr(p[1], length(p[1]) - 3) ":" p[2] ":" p[3]
            }
            return b
        }
        BEGIN {
            n = split(smi, L, "\n")
            for (i = 1; i <= n; i++) {
                split(L[i], f, / *, */)
                if (f[1] != "") map[norm(f[1])] = f[2]
            }
        }
        NF == 0 { next }
        match($0, /Xid \((PCI:)?[0-9a-fA-F:.]+\): [0-9]+(, ?)?/) {
            head = substr($0, RSTART, RLENGTH)
            msg  = substr($0, RSTART + RLENGTH)

            bus = head; sub(/^Xid \((PCI:)?/, "", bus); sub(/\).*/, "", bus)
            xid = head; sub(/^[^)]*\): /, "", xid);       sub(/[^0-9].*/, "", xid)

            key = norm(bus)
            idx = (key in map) ? map[key] : "?"
            short = key; sub(/^[^:]*:/, "", short)
            if (short !~ /\./) short = short ".0"

            printf "%s | GPU %s | %s | Xid %s: %s\n", substr($0, 8, 8), idx, short, xid, msg
            next
        }
        { print }
    '
}

notify() {
    local errors="$1"
    local gpus title
    gpus=$(awk -F' \\| ' '$2 ~ /^GPU / && !seen[$2 FS $3]++ { printf "%s%s (%s)", sep, $2, $3; sep = ", " }' <<< "$errors")
    title="${gpus:-GPU} Xid errors detected"

    if [[ $TELEGRAM_ENABLED -eq 1 ]]; then
        local msg=$'⚠️ *'"$(hostname)"$'* — *'"$title"$':*\n```\n'"$errors"$'\n```'
        curl -s -X POST "https://api.telegram.org/bot$TELEGRAM_TOKEN/sendMessage" \
            -d chat_id="$CHAT_ID" \
            -d parse_mode="Markdown" \
            -d disable_web_page_preview=true \
            --data-urlencode text="$msg" >/dev/null &
    fi

    if [[ -x /hive/bin/message ]]; then
        echo "$errors" | /hive/bin/message danger "$title" payload -i="$(date +%s)" >/dev/null &
    fi
}

read_journal() {
    local num_lines="${1:-0}"

    if [[ "$num_lines" -gt 0 ]]; then
        journalctl -n "$num_lines" -k --no-pager | grep -a "Xid" || true
        return
    fi

    local opts=(-k --no-pager --show-cursor)
    if [[ -s "$CURSOR_FILE" ]]; then
        opts+=(--after-cursor="$(<"$CURSOR_FILE")")
    else
        opts+=(--since="1 hour ago")
    fi

    local out cursor
    out=$(journalctl "${opts[@]}" || true)

    cursor=$(sed -n 's/^-- cursor: //p' <<< "$out" | tail -n1)
    if [[ -n "$cursor" ]]; then
        printf '%s' "$cursor" > "$CURSOR_FILE.tmp" && mv "$CURSOR_FILE.tmp" "$CURSOR_FILE"
    fi

    grep -a "Xid" <<< "$out" || true
}

exec 200>"$LOCK_FILE"
flock 200

errors=$(read_journal "${1:-0}")
[[ -n "$errors" ]] && notify "$(format_errors <<< "$errors")"
wait
exit 0
